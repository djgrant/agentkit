# Copy to secrets.env (gitignored) and fill in real values.
#
# The single store for MCP credentials. Configs only ever hold ${VAR}
# placeholders; run-mcp.ts resolves them from this file when a server spawns.
# Nothing needs to be exported from your shell.

CONTEXT7_API_KEY=
# Issued by the Playwright Extension in the Chrome "Guest" profile.
PLAYWRIGHT_MCP_EXTENSION_TOKEN=
