{
  "model": "{env:OPENCODE_BUILD_MODEL}",
  "autoupdate": true,
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow"
    },
    "skill": "allow",
    "webfetch": "allow",
    "doom_loop": "ask",
    "external_directory": "ask"
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "{env:OPENCODE_BUILD_MODEL}"
    },
    "plan": {
      "mode": "primary",
      "model": "{env:OPENCODE_PLAN_MODEL}"
    },
    "distill": {
      "model": "{env:OPENCODE_PLAN_MODEL}"
    },
    "orchestrate": {
      "model": "{env:OPENCODE_PLAN_MODEL}"
    },
    "architect": {
      "model": "{env:OPENCODE_PLAN_MODEL}"
    },
    "critique": {
      "model": "{env:OPENCODE_PLAN_MODEL}"
    },
    "diverge": {
      "model": "{env:OPENCODE_CREATIVE_MODEL}"
    },
    "ux": {
      "model": "{env:OPENCODE_CREATIVE_MODEL}"
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "bun",
        "/Users/coder/Repos/operations/agentkit/cli/scripts/run-mcp.ts",
        "{}",
        "npx",
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "${CONTEXT7_API_KEY}"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "bun",
        "/Users/coder/Repos/operations/agentkit/cli/scripts/run-mcp.ts",
        "{\"PLAYWRIGHT_MCP_EXTENSION_TOKEN\":\"${PLAYWRIGHT_MCP_EXTENSION_TOKEN}\"}",
        "npx",
        "@playwright/mcp@latest",
        "--extension",
        "--executable-path",
        "/Users/coder/Repos/operations/agentkit/common/mcp/chrome-guest.sh"
      ],
      "enabled": true
    }
  },
  "$schema": "https://opencode.ai/config.json"
}
